<% content_for :title, 'Your next step' %><% steps = @data['mode'] == 'self_pay' ? %w[personal consent result] : %w[personal employment budget consent result] %><% index = steps.index(@step) || 0 %><div class="journey-progress"><span style="width:<%= (index+1)*100/steps.size %>%"></span></div><div class="journey-counter">Step <%= index + 1 %> of <%= steps.size %></div><section class="immersive-content"><div class="onboarding-card journey-card"><div class="eyebrow"><%= @listing.procedure.category %> · YOUR NEXT CHAPTER</div>
<% if @step == 'result' %>
  <div class="result-icon"><%= icon('check', size: 30) %></div><h1>You’re on your way.</h1><p><%= @case.financing_requested? ? 'Our team is reviewing your payment plan. Meanwhile, choose a time that suits you to meet your clinic.' : 'Your care journey is ready. Choose a time that suits you to meet your clinic.' %></p><div class="result-summary"><span><%= @case.procedure.name %></span><strong><%= @case.provider.name %></strong><span>Estimated treatment <b><%= money(@case.estimated_price) %></b></span><span><%= @case.financing_requested? ? 'Payment plan' : 'Payment' %><b><%= @case.financing_requested? ? 'Under review' : 'Pay the clinic directly' %></b></span></div><%= link_to 'Request a consultation →', consultation_case_path(@case), class: 'button primary full' %><%= link_to 'Go to My Care', case_path(@case), class: 'text-link centered' %><p class="fine-print">No financing or medical approval has been made. <%= @case.reference %></p>
<% else %>
<%= form_with url: journey_path(@step) do |f| %>
  <% case @step; when 'personal' %><h1>First, tell us<br>about you.</h1><p>Just the essentials. Two minutes, tops.</p><%= f.label :date_of_birth, 'Date of birth' %><%= f.date_field :date_of_birth, value: @data['date_of_birth'], required: true, max: 18.years.ago.to_date, min: 110.years.ago.to_date %><%= f.label :area, 'Where do you live?' %><%= f.text_field :area, value: @data['area'], placeholder: 'Neighbourhood, city', required: true %><div class="selected-care"><%= icon(category_icon(@listing.procedure.category)) %><div><strong><%= @listing.procedure.name %></strong><span><%= @listing.provider.name %></span></div><b><%= money(@listing.price) %></b></div><fieldset class="pay-choice"><legend>How would you like to pay?</legend><div class="option-list"><label class="radio-option"><%= f.radio_button :mode, 'finance', checked: @data['mode'] != 'self_pay', required: true %><span><strong>Small, small every month</strong><small>Our financing partners review a plan with you.</small></span></label><label class="radio-option"><%= f.radio_button :mode, 'self_pay', checked: @data['mode'] == 'self_pay' %><span><strong>Pay the clinic directly</strong><small>No money questions. Straight to the next step.</small></span></label></div></fieldset>
  <% when 'employment' %><h1>What does your<br>working life look like?</h1><p>This helps us find a plan that fits your life.</p><div class="option-list"><% %w[Employed Self-employed Business-owner Freelancer Other].each do |employment| %><label class="radio-option"><%= f.radio_button :employment, employment, checked: @data['employment'] == employment, required: true %><span><%= employment.tr('-', ' ') %></span></label><% end %></div><%= f.label :monthly_income, 'Approximate monthly income' %><%= f.select :monthly_income, options_for_select([['Below ₦200,000',150000],['₦200,000 – ₦500,000',350000],['₦500,000 – ₦1 million',750000],['₦1 million – ₦2 million',1500000],['₦2 million+',2500000]], @data['monthly_income']), { prompt: 'Select your income range' }, required: true %>
  <% when 'budget' %><h1>What can your<br>pocket carry?</h1><p>Pick a monthly amount that still leaves room for living.</p><%= f.label :monthly_budget, 'Each month, I can comfortably pay' %><div class="budget-input"><span>₦</span><%= f.number_field :monthly_budget, value: @data['monthly_budget'] || 75000, min: 10000, max: 2000000, step: 1000, required: true %></div><div class="note"><%= icon('heart') %><p>This helps our team explore possibilities. It doesn’t commit you to a loan or a procedure.</p></div>
  <% when 'consent' %><h1>Your choices.<br>Your permission.</h1><p>Before we take the next step, here’s what you’re asking Ora to do.</p><div class="result-summary"><span>Your treatment<strong><%= @listing.procedure.name %></strong></span><span>Your clinic<strong><%= @listing.provider.name %></strong></span><span>Estimated treatment<strong><%= money(@listing.price) %></strong></span><span>How you’ll pay<strong><%= @data['mode'] == 'self_pay' ? 'Pay the clinic directly' : 'Small, small every month' %></strong></span></div><label class="checkbox-option"><%= f.check_box :consent, required: true %><span>I agree that Ora may use these details to coordinate my care<%= @data['mode'] == 'self_pay' ? '' : ' and review potential financing options with authorised partners' %>. I understand this is not a medical or financing approval.</span></label><p class="fine-print">In this local preview, information stays in the app. No lender application or clinic notification is sent. <%= link_to 'About your information', privacy_path, target: '_blank' %>.</p>
  <% end %>
  <%= f.submit @step == 'consent' ? 'Begin my care journey →' : 'Continue →', class: 'button primary full' %><% if index > 0 %><%= link_to '← Back', journey_path(steps[index-1]), class: 'quiet-link centered' %><% end %>
<% end %><% end %></div><p class="immersive-caption"><%= icon('lock', size: 13) %> Private and secure. Pause anytime.</p></section>

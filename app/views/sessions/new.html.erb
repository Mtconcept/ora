<% content_for :title, 'A little introduction' %><section class="immersive-content"><div class="onboarding-card"><span class="eyebrow">WELCOME TO ORA</span><h1>A little introduction.</h1><p>Your care journey begins with you. Sign in or create an account with your phone number.</p><%= form_with url: sign_in_path do |f| %><div class="form-columns"><div><%= f.label :first_name, 'First name' %><%= f.text_field :first_name, required: true, autocomplete: 'given-name' %></div><div><%= f.label :last_name, 'Last name' %><%= f.text_field :last_name, required: true, autocomplete: 'family-name' %></div></div><%= f.label :phone, 'Phone number' %><%= f.telephone_field :phone, placeholder: '0801 234 5678', required: true, autocomplete: 'tel' %><%= f.label :email, 'Email address' %><%= f.email_field :email, required: true, autocomplete: 'email' %><%= f.submit 'Continue with my phone →', class: 'button primary full' %><% end %><div class="form-footnote"><%= icon('lock', size: 15) %> Your information stays private.</div><% if demo_mode? %><p class="demo-note">Local preview: a one-time code will appear on the next screen. No SMS is sent.</p><% end %></div><p class="immersive-caption">YOUR WELLBEING. YOUR CHOICES. ALWAYS.</p></section>

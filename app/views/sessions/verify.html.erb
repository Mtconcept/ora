<% content_for :title, 'Verify your phone' %><section class="immersive-content"><div class="onboarding-card"><span class="eyebrow">A MOMENT OF REASSURANCE</span><h1>Make yourself<br>at home.</h1><p>Enter the six-digit code for <strong><%= @user&.phone %></strong>.</p><%= form_with url: verify_path do |f| %><%= f.label :code, 'Verification code' %><%= f.text_field :code, required: true, inputmode: 'numeric', pattern: '[0-9]{6}', maxlength: 6, autocomplete: 'one-time-code', class: 'otp-input', autofocus: true %><%= f.submit 'Continue to my care →', class: 'button primary full' %><% end %><% if demo_mode? && session[:demo_code] %><div class="demo-code"><span>LOCAL PREVIEW CODE · EXPIRES IN 5 MINUTES</span><strong><%= session[:demo_code] %></strong><small>No text message has been sent.</small></div><% end %><%= link_to 'Use a different number or request a new code', sign_in_path, class: 'quiet-link centered' %></div></section>

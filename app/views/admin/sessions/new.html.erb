<% content_for :title, 'Ora operations' %><section class="immersive-content"><div class="onboarding-card"><span class="eyebrow">THE CARE DESK</span><h1>Good care starts<br>behind the scenes.</h1><p>Sign in to the Ora operations workspace.</p><%= form_with url: admin_sign_in_path do |f| %><%= f.label :email, 'Work email' %><%= f.email_field :email, required: true, autocomplete: 'username' %><%= f.label :password, 'Password' %><%= f.password_field :password, required: true, autocomplete: 'current-password' %><%= f.submit 'Enter the care desk →', class: 'button primary full' %><% end %></div></section>

<% content_for :title, "Team management" %><% content_for :page_label, "Settings / Team" %>
<div class="breadcrumb"><%= link_to "Settings", admin_settings_path %> / Team management</div>
<div class="admin-page-heading"><div><h1>Team management</h1><p>Control who can access the Ora admin workspace.</p></div><% if current_admin.super_admin? %><%= link_to new_admin_user_path, class: "button primary small" do %><%= admin_icon("plus", size: 16) %> Add team member<% end %><% end %></div>
<div class="admin-panel"><div class="table-scroll"><table class="admin-user-table"><thead><tr><th>Team member</th><th>Email</th><th>Phone number</th><th>Role</th><th>Status</th><th>Last login</th><th></th></tr></thead><tbody><% @team.each do |user| %><tr class="clickable-row" tabindex="0" data-controller="row-link" data-row-link-url-value="<%= admin_user_path(user) %>" data-action="click->row-link#navigate keydown->row-link#navigateWithKeyboard"><td><%= link_to admin_user_path(user), class: "user-cell" do %><span class="table-avatar"><%= user.name.first.upcase %></span><strong><%= user.name %></strong><% end %></td><td><%= user.email %></td><td><%= user.phone %></td><td><span class="admin-role role-<%= user.role %>"><%= user.role.humanize %></span></td><td><span class="admin-status status-<%= user.status %>"><i></i><%= user.status.humanize %></span></td><td><%= user.last_login_at&.strftime("%d %b %Y, %H:%M") || "Never" %></td><td><%= link_to edit_admin_user_path(user), class: "row-chevron", aria: { label: "Edit #{user.name}" } do %><%= admin_icon("chevron", size: 16) %><% end %></td></tr><% end %></tbody></table></div></div>

<% content_for :title, @customer.name %><% content_for :page_label, "Patients / #{@customer.name}" %>
<div class="breadcrumb"><%= link_to "Patients", admin_customers_path %> / <%= @customer.name %></div>
<div class="admin-page-heading"><div class="admin-user-heading"><span class="profile-avatar"><%= @customer.name.first.upcase %></span><div><h1><%= @customer.name %></h1><p>Patient since <%= @customer.created_at.strftime("%d %B %Y") %></p></div></div><%= link_to "Edit patient", edit_admin_user_path(@customer), class: "button secondary small" %></div>
<div class="admin-detail-grid"><div><div class="admin-panel"><div class="panel-heading"><div><h2>Patient details</h2><p>Contact and account information.</p></div></div><div class="panel-body"><dl class="admin-detail-list"><dt>Email</dt><dd><%= @customer.email.presence || "—" %></dd><dt>Phone</dt><dd><%= @customer.phone %></dd><dt>Status</dt><dd><span class="admin-status status-<%= @customer.status %>"><i></i><%= @customer.status.humanize %></span></dd><dt>Last active</dt><dd><%= @customer.last_active_at&.strftime("%d %b %Y, %H:%M") || "Not recorded" %></dd></dl></div></div><div class="admin-panel"><div class="panel-heading"><div><h2>Care journeys</h2><p><%= pluralize(@cases.size, "journey") %> on this account.</p></div></div><% if @cases.any? %><%= render "admin/cases/table", cases: @cases %><% else %><div class="panel-body"><p class="admin-empty">No care journeys yet.</p></div><% end %></div></div><aside><div class="admin-panel"><div class="panel-heading"><div><h2>Inquiries</h2><p>Messages linked by account or email.</p></div></div><div class="panel-body admin-audit-list"><% @requests.each do |request| %><div><span><%= request.message.truncate(90) %></span><strong><%= request.status.humanize %></strong><small><%= request.created_at.strftime("%d %b %Y, %H:%M") %></small></div><% end %><% if @requests.empty? %><p class="admin-empty">No inquiries from this patient.</p><% end %></div></div></aside></div>

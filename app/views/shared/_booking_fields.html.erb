<div class="form-columns"><div><%= f.label :date, 'Preferred date' %><%= f.date_field :date, required: true, min: Date.tomorrow, max: 60.days.from_now.to_date %></div><div><%= f.label :time, 'Preferred time (WAT)' %><%= f.select :time, [['9:00 AM','09:00'],['11:00 AM','11:00'],['2:00 PM','14:00'],['4:00 PM','16:00']], { prompt: 'Choose a time' }, required: true %></div></div><p class="fine-print">Monday to Friday, within the next 60 days. These are preferred times; Ora will confirm availability with the clinic.</p>

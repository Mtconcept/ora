<% content_for :title, @case.procedure.name %><section class="section case-detail"><div class="breadcrumb"><%= link_to 'My Care', my_care_path %> / <%= @case.reference %></div><div class="section-heading"><div><span class="eyebrow">YOUR CARE JOURNEY</span><h1><%= @case.procedure.name %></h1><p><%= @case.provider.name %> · <%= @case.provider.location %></p></div><%= status_badge(@case.status) %></div>
<% phase = case @case.status; when 'new','qualification' then 0; when 'consultation_booked','medical_review' then 1; when 'treatment_plan' then 2; when 'financing_review','funded' then 3; when 'treatment_booked' then 4; when 'completed' then 5; else -1; end %><div class="care-timeline"><% ['Your starting point','Consultation','Medical assessment','Payment arrangements','Treatment'].each_with_index do |step,index| %><div class="timeline-step <%= index <= phase ? 'reached' : '' %>"><span><%= index < phase ? '✓' : format('%02d',index+1) %></span><small><%= step %></small></div><% end %></div>
<div class="detail-grid"><div><div class="form-card next-step"><span class="eyebrow">YOUR NEXT STEP</span>
<% if @case.status == 'cancelled' %><h2>Room for a different path.</h2><p>This journey has been cancelled. Your next chapter can begin whenever you’re ready.</p><%= link_to 'Explore care →', procedures_path, class: 'button primary' %>
<% elsif @case.status == 'completed' %><h2>A new chapter, begun.</h2><p>Your treatment is marked as complete. For aftercare guidance, follow your provider’s instructions.</p><h3>How was your experience?</h3><%= form_with url: review_case_path(@case) do |f| %><%= f.label :rating, 'Your rating' %><%= f.select :rating, options_for_select((1..5).map { |n| ["#{'★' * n} — #{n} of 5",n] }, @case.rating), prompt: 'Choose a rating' %><%= f.label :review, 'Anything you’d like us to know?' %><%= f.text_area :review, value: @case.review, rows: 3 %><%= f.submit 'Share my experience', class: 'button primary' %><% end %>
<% elsif @case.medical_status == 'not_approved' %><h2>Let’s consider the next step.</h2><p>Your provider has not approved this treatment. Speak with your clinician about their assessment and other appropriate options.</p><%= link_to 'Talk to Ora ↗', support_path, class: 'button primary' %>
<% elsif @case.status == 'treatment_booked' %><h2>A date to look towards.</h2><p>Your preferred treatment date is <strong><%= @case.treatment_at.strftime('%A, %d %B at %I:%M %p WAT') %></strong>. <%= @case.treatment_confirmed? ? "Your clinic has confirmed this booking." : "Ora will confirm the arrangements with your clinic." %></p><h3>Provider preparation notes</h3><p><%= @case.preparation.presence || 'Your provider has not added preparation instructions yet. Ora will coordinate these before your visit.' %></p>
<% elsif @case.ready_to_book? %><h2>Let’s find your day.</h2><p>Your medical assessment<%= @case.financing_requested? ? ' and funding are' : ' is' %> recorded. Choose your preferred treatment date.</p><%= form_with url: book_treatment_case_path(@case) do |f| %><%= render 'shared/booking_fields', f: f %><%= f.submit 'Request treatment date →', class: 'button primary full' %><% end %>
<% elsif @case.ready_for_terms? %><h2>Your plan is ready to consider.</h2><p>Your provider has completed the medical assessment. Take your time reviewing the final price and financing terms.</p><%= link_to 'Review my treatment plan →', plan_case_path(@case), class: 'button primary' %>
<% elsif @case.financing_status == 'accepted' %><h2>The next step is in motion.</h2><p>Your acceptance is recorded. We’re waiting for funding confirmation before arranging treatment.</p>
<% elsif @case.medical_status == 'approved' %><h2>A plan, taking shape.</h2><p>Your provider has recorded medical approval. Ora is coordinating the final treatment and payment details.</p><%= link_to 'View treatment plan →', plan_case_path(@case), class: 'button primary' %>
<% elsif @case.consultation_at %><h2>A conversation worth having.</h2><p>Your consultation request is saved for <strong><%= @case.consultation_at.strftime('%A, %d %B at %I:%M %p WAT') %></strong>.</p><div class="note"><%= icon('calendar') %><p><%= @case.consultation_mode.humanize %> · <%= @case.consultation_confirmed? ? "Your clinic has confirmed this appointment." : "Clinic confirmation pending. No appointment is guaranteed until your provider confirms." %></p></div><%= link_to 'Change my preferred time', consultation_case_path(@case), class: 'text-link' %>
<% else %><h2>Begin with a conversation.</h2><p>Meet your provider, ask your questions, and understand what’s right for you.</p><%= link_to 'Request a consultation →', consultation_case_path(@case), class: 'button primary' %><% end %></div>
<div class="form-card activity"><span class="eyebrow">ALONG THE WAY</span><h3>Your journey, so far.</h3><% @case.case_events.order(created_at: :desc).each do |event| %><div class="activity-item"><span class="activity-dot"></span><div><p><%= event.message %></p><small><%= event.created_at.strftime('%d %b %Y · %I:%M %p') %></small></div></div><% end %></div></div>
<aside><div class="sticky-card"><span class="eyebrow">THE DETAILS, SIMPLY</span><h3>Your care at a glance.</h3><dl class="details-list"><dt>Estimated treatment</dt><dd><%= money(@case.estimated_price) %></dd><% if @case.final_price %><dt>Final treatment price</dt><dd><%= money(@case.final_price) %></dd><% end %><dt>Medical assessment</dt><dd><%= status_badge(@case.medical_status) %></dd><% if @case.upfront_amount.positive? %><dt>Upfront contribution</dt><dd><%= money(@case.upfront_amount) %> · <%= @case.upfront_confirmed? ? "Receipt confirmed" : "Receipt pending" %></dd><% end %><dt>Payment preference</dt><dd><%= @case.financing_requested? ? 'Explore financing' : 'Pay provider directly' %></dd><% if @case.financing_requested? %><dt>Financing</dt><dd><%= status_badge(@case.financing_status) %></dd><% if @case.approved_amount %><dt>Recorded financing amount</dt><dd><%= money(@case.approved_amount) %></dd><% end %><% end %></dl>
<% if @case.financing_status == 'partial' %><div class="note"><p>A partial option is available for review. The current difference is <strong><%= money(@case.funding_gap) %></strong>. Speak with Ora about an upfront contribution or updated financing.</p></div><%= button_to 'Request updated financing', request_revision_case_path(@case), class: 'button outline full' %><% elsif @case.financing_status == 'unavailable' %><p>We haven’t found a financing option yet. You can explore other care or request another review.</p><%= button_to 'Request another review', request_revision_case_path(@case), class: 'button outline full' %><% end %><%= link_to 'Talk to your Ora team ↗', support_path, class: 'text-link' %><% unless %w[completed cancelled funded treatment_booked].include?(@case.status) || %w[accepted funded].include?(@case.financing_status) %><hr><%= button_to 'Cancel this care journey', cancel_case_path(@case), class: 'quiet-link danger', data: { turbo_confirm: 'Cancel this care journey? Your record will remain available in My Care.' } %><% end %></div></aside></div></section>

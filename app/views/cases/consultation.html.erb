<% content_for :title, 'Your consultation' %><section class="page-heading"><span class="eyebrow">A CONVERSATION COMES FIRST</span><h1>Make a little<br><em>time for yourself.</em></h1><p>Choose when you’d like to meet your provider.</p></section><section class="section narrow"><div class="form-card"><div class="selected-care"><%= icon(category_icon(@case.procedure.category)) %><div><strong><%= @case.procedure.name %></strong><span><%= @case.provider.name %> · <%= @case.provider.location %></span></div></div><%= form_with url: book_consultation_case_path(@case) do |f| %><%= render 'shared/booking_fields', f: f %><%= f.label :mode, 'How would you like to meet?' %><div class="option-list"><label class="radio-option"><%= f.radio_button :mode, 'in_person', checked: true %><span>In person, at the practice</span></label><label class="radio-option"><%= f.radio_button :mode, 'virtual' %><span>Virtually, if offered by the provider</span></label></div><%= f.submit 'Request my consultation →', class: 'button primary full' %><% end %><p class="fine-print">Consultation fees and availability will be confirmed by the clinic. This request does not book a procedure or commit you to financing.</p><%= link_to '← Back to My Care', case_path(@case), class: 'quiet-link' %></div></section>

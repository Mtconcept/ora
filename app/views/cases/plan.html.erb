<% content_for :title, 'Your treatment plan' %><section class="page-heading"><span class="eyebrow">CLARITY BEFORE COMMITMENT</span><h1>Your plan.<br><em>Every detail considered.</em></h1><p><%= @case.procedure.name %> · <%= @case.provider.name %></p></section><section class="section narrow"><div class="form-card"><h2>Your treatment plan</h2><dl class="details-list"><dt>Medical assessment</dt><dd><%= status_badge(@case.medical_status) %></dd><dt>Original estimate</dt><dd><%= money(@case.estimated_price) %></dd><dt>Final treatment price</dt><dd><%= @case.final_price ? money(@case.final_price) : 'Awaiting provider' %></dd><% if @case.financing_requested? %><dt>Financing amount</dt><dd><%= @case.approved_amount ? money(@case.approved_amount) : 'Under review' %></dd><% if @case.upfront_amount.positive? %><dt>Your upfront contribution</dt><dd><%= money(@case.upfront_amount) %></dd><dt>Contribution receipt</dt><dd><%= @case.upfront_confirmed? ? "Confirmed by provider" : "Pending confirmation" %></dd><% end %><dt>Financing provider</dt><dd><%= @case.lender_name.presence || 'Not yet assigned' %></dd><dt>Term</dt><dd><%= @case.term_months %> months</dd><dt>Monthly payment</dt><dd><%= @case.monthly_payment ? money(@case.monthly_payment) : 'To be confirmed' %></dd><% if @case.monthly_payment %><dt>Total repayments</dt><dd><%= money(@case.monthly_payment * @case.term_months) %></dd><% end %><% end %></dl><% if @case.final_price && @case.final_price != @case.estimated_price %><div class="note"><p>Your treatment plan has changed following consultation. Please review the updated price before making a decision.</p></div><% end %><% if @case.financing_requested? && @case.approved_amount && @case.funding_gap.positive? %><div class="form-errors">The current financing leaves a difference of <%= money(@case.funding_gap) %>. Speak with Ora about an upfront contribution or request an updated review before proceeding.</div><%= button_to 'Request updated financing', request_revision_case_path(@case), class: 'button outline full' %><% end %>
<% if @case.financing_terms.present? %><h3>Recorded financing terms</h3><div class="terms-copy"><%= simple_format(@case.financing_terms) %></div><% end %>
<% if @case.ready_for_terms? %><%= form_with url: accept_terms_case_path(@case) do |f| %><label class="checkbox-option"><%= f.check_box :consent, required: true %><span>I have reviewed the treatment price, lender information, repayment amounts, and recorded financing terms, and agree to proceed.</span></label><%= f.submit demo_mode? ? 'Record demo acceptance →' : 'Accept financing terms →', class: 'button primary full' %><% end %><% else %><p class="fine-print">Acceptance becomes available after medical approval and a complete, sufficient financing offer. <%= @case.terms_accepted_at ? "Terms accepted #{@case.terms_accepted_at.strftime('%d %b %Y')}." : '' %></p><% end %><p class="fine-print">Ora coordinates care. The financing partner is the lender. In this preview, acceptance only updates the local care record; no credit agreement or payment is executed.</p><%= link_to '← Back to My Care', case_path(@case), class: 'text-link' %></div></section>

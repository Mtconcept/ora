<% content_for :title, 'My Care' %><section class="page-heading care-heading"><span class="eyebrow">YOUR OWN PACE. YOUR OWN PATH.</span><h1>A little more you,<br><em><%= current_user.first_name %>.</em></h1><p>Your possibilities, your plans, and the people helping you get there.</p></section><section class="section my-care-section"><div class="section-heading"><h2>Your care journeys</h2><%= link_to 'Explore another possibility ↗', procedures_path, class: 'text-link' %></div><% if @cases.empty? %><div class="empty-state"><%= icon('heart', size: 40) %><h2>Your next chapter is unwritten.</h2><p>Explore care, save what speaks to you, and take a first step whenever you’re ready.</p><%= link_to 'Find my starting point →', procedures_path, class: 'button primary' %></div><% end %><div class="care-cards"><% @cases.each do |care| %><%= link_to case_path(care), class: 'care-card' do %><div class="care-card-icon category-<%= care.procedure.category.downcase %>"><%= icon(category_icon(care.procedure.category), size: 36) %></div><div class="care-card-main"><span class="eyebrow"><%= care.reference %></span><h3><%= care.procedure.name %></h3><p><%= care.provider.name %> · <%= care.provider.location %></p><div class="care-card-meta"><span><%= icon('calendar', size: 16) %> <%= care.consultation_at ? care.consultation_at.strftime('%d %b, %I:%M %p WAT') : 'Consultation to be arranged' %></span><%= status_badge(care.status) %></div></div><%= icon('arrow') %><% end %><% end %></div><% if @saved.any? %><div class="section-heading saved-heading"><div><span class="eyebrow">FOR WHENEVER YOU’RE READY</span><h2>Saved possibilities.</h2></div></div><div class="procedure-grid"><%= render partial: 'shared/procedure', collection: @saved %></div><% end %></section>
